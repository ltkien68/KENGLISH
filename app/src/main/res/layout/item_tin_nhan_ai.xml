<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingBottom="16dp">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/kai_avatar"
        android:scaleType="centerCrop"
        android:contentDescription="Avatar trợ lý Kai" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/juve_headin"
            android:text="Kai"
            android:textColor="#1877F2"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txt_noi_dung_tin_nhan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/nen_tin_nhan_ai"
            android:fontFamily="@font/juve_normal"
            android:padding="14dp"
            android:textColor="#111111"
            android:textIsSelectable="true"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>

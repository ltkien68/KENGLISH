<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#182230"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/khung_xac_thuc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="70dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <ImageView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:contentDescription="Logo Kenglish"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_logo_kenglish" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Xác thực email"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Mã xác thực đã được gửi tới email của bạn"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edt_ma_xac_thuc"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/nen_input_dangnhap"
            android:gravity="center"
            android:hint="Nhập mã OTP"
            android:inputType="number"
            android:maxLength="6"
            android:letterSpacing="0.25"
            android:textColor="#FFFFFF"
            android:textColorHint="#8391A5"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_xac_thuc"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/nen_nut_xacnhan"
            android:gravity="center"
            android:text="Xác thực"
            android:textColor="#182230"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_gui_lai"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Không nhận được mã?  Gửi lại"
            android:textColor="#CBD5E1"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
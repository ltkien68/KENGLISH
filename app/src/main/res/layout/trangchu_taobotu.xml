<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="180dp"
android:layout_marginTop="24dp"
app:cardCornerRadius="6dp"
app:cardElevation="0dp"
app:strokeWidth="0dp">

<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Ảnh nền -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/banner_trangchu" />


    <!-- Nội dung bên trái -->
    <LinearLayout
        android:layout_width="190dp"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">


        <!-- Tiêu đề -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/juve_headin"
            android:text="TỰ TẠO BỘ TỪ&#10;CỦA RIÊNG BẠN"
            android:textColor="#111111"
            android:textSize="20sp" />


        <!-- Mô tả -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/juve_normal"
            android:maxLines="2"
            android:text="Thêm những từ bạn muốn học và luyện tập theo cách riêng."
            android:textColor="#7C8492"
            android:textSize="13sp" />


        <!-- Nút tạo bộ từ -->
        <LinearLayout
            android:id="@+id/layout_tao_bo_tu"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/nen_trangchu_taobotu"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="88dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:id="@+id/btn_tao_bo_tu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/juve_headin"
                android:text="TẠO NGAY"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginStart="6dp"
                android:contentDescription="Tạo bộ từ"
                android:src="@drawable/ic_muitenphai"
                app:tint="#FFFFFF" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>

</com.google.android.material.card.MaterialCardView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/btn_quay_lai"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:fontFamily="@font/juve_headin"
        android:text="← QUAY LẠI"
        android:textColor="#37659C"
        android:textSize="13sp"/>

    <TextView
        android:id="@+id/txt_tieu_de_flashcard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/juve_headin"
        android:text="FLASHCARD"
        android:textColor="#111111"
        android:textSize="17sp"/>

    <TextView
        android:id="@+id/txt_tien_do_flashcard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/juve_normal"
        android:text="1 / 20"
        android:textColor="#7C8492"
        android:textSize="13sp"/>

    <ProgressBar
        android:id="@+id/progress_flashcard"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#37659C"/>

    <LinearLayout
        android:id="@+id/card_flashcard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/nen_flashcard"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txt_mat_the"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/juve_normal"
            android:text="MẶT TRƯỚC"
            android:textColor="#7C8492"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/txt_tu_flashcard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/juve_headin"
            android:gravity="center"
            android:text="Vocabulary"
            android:textColor="#111111"
            android:textSize="17sp"/>

        <TextView
            android:id="@+id/txt_phien_am_flashcard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/juve_normal"
            android:gravity="center"
            android:text="/vəˈkæbjələri/"
            android:textColor="#7C8492"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/txt_loai_tu_flashcard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/juve_normal"
            android:gravity="center"
            android:textColor="#37659C"
            android:textSize="13sp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/txt_vi_du_flashcard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/juve_normal"
            android:gravity="center"
            android:textColor="#7C8492"
            android:textSize="13sp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/txt_goi_y_lat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/juve_normal"
            android:text="Chạm để lật thẻ"
            android:textColor="#37659C"
            android:textSize="11sp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_truoc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:fontFamily="@font/juve_headin"
            android:text="← TRƯỚC"
            android:textColor="#37659C"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/btn_tiep"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:fontFamily="@font/juve_headin"
            android:text="TIẾP →"
            android:textColor="#37659C"
            android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_chua_thuoc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/nen_flashcard"
            android:gravity="center"
            android:fontFamily="@font/juve_headin"
            android:text="CHƯA THUỘC"
            android:textColor="#37659C"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/btn_da_thuoc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="#37659C"
            android:gravity="center"
            android:fontFamily="@font/juve_headin"
            android:text="ĐÃ THUỘC"
            android:textColor="#FFFFFF"
            android:textSize="13sp"/>
    </LinearLayout>

</LinearLayout>

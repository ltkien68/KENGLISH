<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/nen_nutcardbotu"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Tên bộ từ + menu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txt_ten_bo_tu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="TOEIC Part 5"
            android:textColor="#111111"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btn_menu_bo_tu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#7C8492"
            android:textSize="20sp" />

    </LinearLayout>

    <!-- Số lượng từ -->
    <TextView
        android:id="@+id/txt_so_luong_tu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif"
        android:text="30 từ"
        android:textColor="#7C8492"
        android:textSize="13sp" />

    <!-- Thông tin tiến độ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:text="Đã thuộc"
            android:textColor="#7C8492"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txt_tien_do"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="12/30"
            android:textColor="#087CFF"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Thanh tiến độ -->
    <ProgressBar
        android:id="@+id/progress_bo_tu"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="40"
        android:progressDrawable="@drawable/nen_botu_progress" />

    <!-- Các nút thao tác -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <!-- Xem -->
        <TextView
            android:id="@+id/btn_xem_bo_tu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/nen_botu_nutphu"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="XEM"
            android:textColor="#087CFF"
            android:textSize="13sp" />

        <!-- Luyện tập -->
        <TextView
            android:id="@+id/btn_luyen_tap_bo_tu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/nen_nuttaobotu"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="LUYỆN TẬP"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="20dp"
    android:background="@drawable/nen_luyentap_lichsu"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:padding="12dp"
            android:src="@drawable/ic_lichsu"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Lịch sử đấu"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_xem_thong_ke"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◔  Xem thống kê"
            android:textColor="#27C7B8"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ListView
        android:id="@+id/list_lich_su"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="14dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:listSelector="@android:color/transparent"
        android:scrollbars="none" />

</LinearLayout>
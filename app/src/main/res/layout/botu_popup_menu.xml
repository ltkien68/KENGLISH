<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="150dp"
    android:layout_height="wrap_content"
    android:background="@drawable/nen_botu_popup_menu"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/btn_xoa_bo_tu"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Xóa bộ từ"
            android:src="@drawable/ic_thungrac"
            android:tint="#D64545" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/juve_normal"
            android:text="Xóa bộ từ"
            android:textColor="#D64545"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>
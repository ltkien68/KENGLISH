<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/khung_dat_lai_mat_khau"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal|center_vertical"
        android:paddingStart="24dp"
        android:paddingTop="50dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <!-- Logo Kenglish -->
        <ImageView
            android:id="@+id/img_logo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_logo_kenglish"
            android:scaleType="fitStart"
            android:contentDescription="Logo Kenglish" />

        <!-- Tiêu đề -->
        <TextView
            android:id="@+id/txt_tieu_de"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Đặt lại mật khẩu"
            android:textColor="#0B3475"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Mật khẩu mới -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_mat_khau_moi"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Mật khẩu mới"
            app:boxBackgroundMode="outline"
            app:boxBackgroundColor="#F5FAFF"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="@color/mau_vien_input_dang_ky"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconMode="password_toggle"
            app:endIconTint="#7C8492"
            app:hintEnabled="true"
            app:hintAnimationEnabled="true"
            app:hintTextColor="@color/mau_vien_input_dang_ky"
            app:expandedHintEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_mat_khau_moi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="46dp"
                android:background="@null"
                android:inputType="textPassword"
                android:singleLine="true"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:textColor="#0B3475"
                android:textColorHint="#7C8492"
                android:textSize="13sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Nhập lại mật khẩu -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_nhap_lai_mat_khau"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Nhập lại mật khẩu"
            app:boxBackgroundMode="outline"
            app:boxBackgroundColor="#F5FAFF"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="@color/mau_vien_input_dang_ky"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconMode="password_toggle"
            app:endIconTint="#7C8492"
            app:hintEnabled="true"
            app:hintAnimationEnabled="true"
            app:hintTextColor="@color/mau_vien_input_dang_ky"
            app:expandedHintEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_nhap_lai_mat_khau"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="46dp"
                android:background="@null"
                android:inputType="textPassword"
                android:singleLine="true"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:textColor="#0B3475"
                android:textColorHint="#7C8492"
                android:textSize="13sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Thông báo lỗi -->
        <TextView
            android:id="@+id/txt_loi_dat_lai_mat_khau"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#C94A4A"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Nút đặt lại mật khẩu -->
        <TextView
            android:id="@+id/btn_dat_lai_mat_khau"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/nen_nut_dang_ky_moi"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="ĐẶT LẠI MẬT KHẨU"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
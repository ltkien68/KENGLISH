<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="24dp"
    android:paddingEnd="16dp">


    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_quay_lai"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:contentDescription="Quay lại"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_back"
            app:tint="#37659C" />

        <TextView
            android:id="@+id/txt_ten_bo_tu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/juve_headin"
            android:maxLines="1"
            android:text="TOEIC"
            android:textColor="#111111"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/btn_them_tu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:contentDescription="Thêm từ"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_add"
            app:tint="#37659C" />

    </LinearLayout>


    <!-- MÔ TẢ -->
    <TextView
        android:id="@+id/txt_mo_ta_bo_tu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/juve_normal"
        android:text="Theo dõi tiến độ học tập của bộ từ"
        android:textColor="#7C8492"
        android:textSize="13sp" />


    <!-- THỐNG KÊ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/nen_botu_thongke"
        android:orientation="horizontal"
        android:padding="14dp">


        <!-- Tổng từ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_tong_tu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/juve_headin"
                android:text="0"
                android:textColor="#111111"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/juve_normal"
                android:text="Tổng từ"
                android:textColor="#7C8492"
                android:textSize="11sp" />

        </LinearLayout>


        <View
            android:layout_width="1dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:background="#E2E3E3" />


        <!-- Đã thuộc -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_da_thuoc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/juve_headin"
                android:text="0"
                android:textColor="#37659C"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/juve_normal"
                android:text="Đã thuộc"
                android:textColor="#7C8492"
                android:textSize="11sp" />

        </LinearLayout>


        <View
            android:layout_width="1dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:background="#E2E3E3" />


        <!-- Chưa thuộc -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_chua_thuoc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/juve_headin"
                android:text="0"
                android:textColor="#111111"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/juve_normal"
                android:text="Chưa thuộc"
                android:textColor="#7C8492"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>


    <!-- TÌM KIẾM -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/nen_botu_timkiem"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_kinhlup"
            app:tint="#7C8492" />

        <EditText
            android:id="@+id/edt_tim_tu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/juve_normal"
            android:hint="Tìm từ..."
            android:singleLine="true"
            android:textColor="#4F4F4F"
            android:textColorHint="#A9A9A9"
            android:textSize="13sp" />

    </LinearLayout>


    <!-- ACTION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_hoc_ngay"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/nen_nut_xanh"
            android:fontFamily="@font/juve_headin"
            android:gravity="center"
            android:text="HỌC NGAY"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />


    </LinearLayout>


    <!-- FILTER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_tat_ca"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/nen_filter_active"
            android:fontFamily="@font/juve_headin"
            android:gravity="center"
            android:text="Tất cả"
            android:textColor="#37659C"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btn_da_thuoc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/nen_filter"
            android:fontFamily="@font/juve_normal"
            android:gravity="center"
            android:text="Đã thuộc"
            android:textColor="#7C8492"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btn_chua_thuoc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/nen_filter"
            android:fontFamily="@font/juve_normal"
            android:gravity="center"
            android:text="Chưa thuộc"
            android:textColor="#7C8492"
            android:textSize="11sp" />

    </LinearLayout>


    <!-- LIST -->
    <ListView
        android:id="@+id/list_tu_vung"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:overScrollMode="never"
        android:paddingBottom="16dp"
        android:scrollbars="none" />

</LinearLayout>
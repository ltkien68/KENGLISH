<?xml version="1.0" encoding="utf-8"?>

<!--
    Màn hình Cửa hàng.
    Chức năng hiện đang trong quá trình phát triển.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="50dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">


    <!-- ================================================= -->
    <!-- Tiêu đề trang -->
    <!-- ================================================= -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/juve_headin"
        android:text="CỬA HÀNG"
        android:textColor="#0B3475"
        android:textStyle="bold"
        android:textSize="20sp" />


    <!-- ================================================= -->
    <!-- Nội dung đang phát triển -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Icon -->
        <ImageView
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:contentDescription="Đang phát triển"
            android:scaleType="centerInside"
            android:src="@drawable/img_dang_phat_trien" />

        <!-- Thông báo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/juve_headin"
            android:text="Đang phát triển"
            android:textColor="#111111"
            android:textSize="17sp" />

        <!-- Mô tả -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/juve_normal"
            android:gravity="center"
            android:text="Tính năng này sẽ sớm được cập nhật"
            android:textColor="#7C8492"
            android:textSize="15sp" />

    </LinearLayout>

</LinearLayout>
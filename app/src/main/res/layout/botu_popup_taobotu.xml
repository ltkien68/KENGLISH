<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/nen_popupbotu"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="26dp">


    <!-- Thanh kéo -->
    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#637083" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Tạo bộ từ mới"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />


    <EditText
        android:id="@+id/edt_ten_bo_tu"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/nen_onhapbotu"
        android:hint="Tên bộ từ *"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#8795A7"
        android:textSize="11sp" />


    <EditText
        android:id="@+id/edt_mo_ta_bo_tu"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/nen_onhapbotu"
        android:gravity="top"
        android:hint="Mô tả (tùy chọn)"
        android:padding="16dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#8795A7"
        android:textSize="11sp" />


    <TextView
        android:id="@+id/btn_xac_nhan_tao_bo_tu"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/nen_nuttaobotu"
        android:gravity="center"
        android:text="TẠO"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
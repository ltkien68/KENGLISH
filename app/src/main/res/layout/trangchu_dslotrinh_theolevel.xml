<?xml version="1.0" encoding="utf-8"?>

<!--
    Nhóm lộ trình theolevel.
    Hiển thị tiêu đề nhóm và 4 bộ từ demo theo chiều ngang.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="18dp"
    android:orientation="vertical">


    <!-- ================================================= -->
    <!-- TIÊU ĐỀ NHÓM -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="14dp" >


        <!-- Tên nhóm -->
        <TextView
            android:id="@+id/txt_tieu_de_theolevel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Theo level"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />


        <!-- Số lượng bộ từ -->
        <TextView
            android:id="@+id/txt_so_bo_theolevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4 bộ từ"
            android:textColor="#9AA6B8"
            android:textSize="12sp" />


    </LinearLayout>


    <!-- ================================================= -->
    <!-- DANH SÁCH BỘ TỪ -->
    <!-- ================================================= -->

    <HorizontalScrollView
        android:id="@+id/cuon_bo_tu_theolevel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">


        <LinearLayout
            android:id="@+id/danh_sach_bo_tu_theolevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <!-- ================================================= -->
            <!-- BỘ TỪ 1 -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/the_theolevel_co_ban"
                android:layout_width="135dp"
                android:layout_height="135dp"
                android:layout_marginEnd="9dp"
                app:cardBackgroundColor="#1B2535"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="11dp">


                    <!-- Tên bộ từ -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:maxLines="2"
                        android:text="A1 (0-3.0)"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />


                    <!-- Số lượng từ -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="27dp"
                        android:background="#151D28"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="7dp"
                        android:paddingEnd="9dp">


                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:contentDescription="Icon bộ từ"
                            android:src="@drawable/nen_nhan_lo_trinh" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="300 từ"
                            android:textColor="#DCE3ED"
                            android:textSize="10sp"
                            android:textStyle="bold" />


                    </LinearLayout>


                    <!-- Tiến độ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TIẾN ĐỘ"
                            android:textColor="#8995A8"
                            android:textSize="9sp" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="65%"
                            android:textColor="#35C759"
                            android:textSize="10sp"
                            android:textStyle="bold" />


                    </LinearLayout>


                    <ProgressBar
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_marginTop="5dp"
                        android:max="100"
                        android:progress="65"
                        android:progressBackgroundTint="#2A3547"
                        android:progressTint="#35C759" />


                </LinearLayout>


            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- BỘ TỪ 2 -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/the_theolevel_450"
                android:layout_width="135dp"
                android:layout_height="135dp"
                android:layout_marginEnd="9dp"
                app:cardBackgroundColor="#1B2535"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="11dp">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:maxLines="2"
                        android:text="A2 (3.0-3.5)"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="27dp"
                        android:background="#151D28"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="7dp"
                        android:paddingEnd="9dp">


                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:contentDescription="Icon bộ từ"
                            android:src="@drawable/nen_nhan_lo_trinh" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="450 từ"
                            android:textColor="#DCE3ED"
                            android:textSize="10sp"
                            android:textStyle="bold" />


                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TIẾN ĐỘ"
                            android:textColor="#8995A8"
                            android:textSize="9sp" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="42%"
                            android:textColor="#9BE22D"
                            android:textSize="10sp"
                            android:textStyle="bold" />


                    </LinearLayout>


                    <ProgressBar
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_marginTop="5dp"
                        android:max="100"
                        android:progress="42"
                        android:progressBackgroundTint="#2A3547"
                        android:progressTint="#9BE22D" />


                </LinearLayout>


            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- BỘ TỪ 3 -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/the_theolevel_650"
                android:layout_width="135dp"
                android:layout_height="135dp"
                android:layout_marginEnd="9dp"
                app:cardBackgroundColor="#1B2535"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="11dp">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:maxLines="2"
                        android:text="B1 (4.0-5.0)"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="27dp"
                        android:background="#151D28"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="7dp"
                        android:paddingEnd="9dp">


                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:contentDescription="Icon bộ từ"
                            android:src="@drawable/nen_nhan_lo_trinh" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="600 từ"
                            android:textColor="#DCE3ED"
                            android:textSize="10sp"
                            android:textStyle="bold" />


                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TIẾN ĐỘ"
                            android:textColor="#8995A8"
                            android:textSize="9sp" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="18%"
                            android:textColor="#FFD43B"
                            android:textSize="10sp"
                            android:textStyle="bold" />


                    </LinearLayout>


                    <ProgressBar
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_marginTop="5dp"
                        android:max="100"
                        android:progress="18"
                        android:progressBackgroundTint="#2A3547"
                        android:progressTint="#FFD43B" />


                </LinearLayout>


            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- BỘ TỪ 4 -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/the_theolevel_850"
                android:layout_width="135dp"
                android:layout_height="135dp"
                app:cardBackgroundColor="#1B2535"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="11dp">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:maxLines="2"
                        android:text="B2 (5.5-6.5)"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="27dp"
                        android:background="#151D28"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="7dp"
                        android:paddingEnd="9dp">


                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:contentDescription="Icon bộ từ"
                            android:src="@drawable/nen_nhan_lo_trinh" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="800 từ"
                            android:textColor="#DCE3ED"
                            android:textSize="10sp"
                            android:textStyle="bold" />


                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TIẾN ĐỘ"
                            android:textColor="#8995A8"
                            android:textSize="9sp" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="#22A8E8"
                            android:textSize="10sp"
                            android:textStyle="bold" />


                    </LinearLayout>


                    <ProgressBar
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_marginTop="5dp"
                        android:max="100"
                        android:progress="0"
                        android:progressBackgroundTint="#2A3547"
                        android:progressTint="#22A8E8" />


                </LinearLayout>


            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>


    </HorizontalScrollView>


</LinearLayout>
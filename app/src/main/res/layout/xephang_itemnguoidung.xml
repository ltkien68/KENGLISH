<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="#FFFFFF"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <TextView
        android:id="@+id/txt_hang"
        android:layout_width="42dp"
        android:layout_height="match_parent"
        android:fontFamily="@font/juve_headin"
        android:gravity="center"
        android:text="1"
        android:textColor="#111111"
        android:textSize="15sp" />
    <ImageView
        android:id="@+id/img_anh_dai_dien"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/nen_xephang_avatar"
        android:contentDescription="Ảnh đại diện"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_menu_myplaces"
        android:tint="#37659C" />
    <TextView
        android:id="@+id/txt_ten_nguoi_dung"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/juve_normal"
        android:maxLines="1"
        android:text="Tên người dùng"
        android:textColor="#111111"
        android:textSize="13sp" />
    <LinearLayout
        android:layout_width="70dp"
        android:layout_height="match_parent"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/txt_diem_xep_hang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/juve_headin"
            android:text="0"
            android:textColor="#37659C"
            android:textSize="13sp" />
        <ImageView
            android:id="@+id/img_icon_diem"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="5dp"
            android:contentDescription="Loại điểm"
            android:scaleType="centerInside"
            android:src="@drawable/ic_tiaset" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/nen_luyentap_item_lichsu"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/txt_icon_lich_su"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:padding="12dp"
        android:src="@drawable/ic_lichsu"
        app:tint="#A855F7" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_ten_game_lich_su"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trắc nghiệm"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_ket_qua_lich_su"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="9/10 đúng · 90%"
            android:textColor="#D0D5DD"
            android:textSize="10sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/txt_coin_lich_su"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+119 🪙"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
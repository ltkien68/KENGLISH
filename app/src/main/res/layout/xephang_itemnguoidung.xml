<?xml version="1.0" encoding="utf-8"?>

<!-- Một người dùng trong bảng xếp hạng -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <!-- Hạng -->
    <TextView
        android:id="@+id/txt_hang"
        android:layout_width="42dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="1"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/nen_xephang_hang" />


    <!-- Avatar -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/img_anh_dai_dien"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="8dp"
        android:scaleType="centerCrop"
        android:src="@android:drawable/sym_def_app_icon"
        android:contentDescription="Ảnh đại diện" />


    <!-- Tên -->
    <TextView
        android:id="@+id/txt_ten_nguoi_dung"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Người dùng"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />


    <!-- Giá trị xếp hạng -->
    <TextView
        android:id="@+id/txt_diem_xep_hang"
        android:layout_width="72dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="121 ⚡"
        android:textColor="#FFD43B"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
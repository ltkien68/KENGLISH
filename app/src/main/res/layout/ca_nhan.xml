<?xml version="1.0" encoding="utf-8"?>

<!--
    Trang cá nhân Kenglish.
    Các khối giao diện được tách thành component riêng để dễ quản lý.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#182230"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">


    <!-- Nội dung chính -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="30dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">


        <!-- Thông tin người dùng -->
        <include
            layout="@layout/canhan_thongtinnguoidung" />


        <!-- Streak học tập -->
        <include
            layout="@layout/canhan_streak" />


        <!-- Thông báo -->
        <include
            layout="@layout/canhan_thongbao" />


        <!-- Hỗ trợ -->
        <include
            layout="@layout/canhan_hotro" />


        <!-- Pháp lý -->
        <include
            layout="@layout/canhan_phaply" />


        <!-- Theo dõi chúng tôi -->
        <include
            layout="@layout/canhan_theodoi" />


        <!-- Tài khoản -->
        <include
            layout="@layout/canhan_taikhoan" />


    </LinearLayout>


</androidx.core.widget.NestedScrollView>
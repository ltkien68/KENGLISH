<?xml version="1.0" encoding="utf-8"?>

<!--
    Component tài khoản.
    Chứa đăng xuất và xóa tài khoản.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">


    <!-- Tiêu đề -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/juve_headin"
        android:text="TÀI KHOẢN"
        android:textColor="#0B3475"
        android:textStyle="bold"
        android:textSize="17sp" />


    <!-- Đăng xuất -->
    <LinearLayout
        android:id="@+id/card_dang_xuat"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">


        <!-- Icon -->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/nen_icon_do"
            android:contentDescription="Đăng xuất"
            android:padding="8dp"
            android:src="@drawable/ic_dangxuat"
            app:tint="#D64545" />


        <!-- Tên chức năng -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/juve_normal"
            android:text="Đăng xuất"
            android:textColor="#D64545"
            android:textSize="15sp"
            android:textStyle="bold" />


        <!-- Điều hướng -->
        <ImageView
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:src="@drawable/ic_arrowright"
            android:tint="#7C8492"
            android:contentDescription="Mũi tên" />

    </LinearLayout>


    <!-- Đường phân cách -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="44dp"
        android:background="#E2E3E3" />


    <!-- Xóa tài khoản -->
    <LinearLayout
        android:id="@+id/card_xoa_tai_khoan"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">


        <!-- Icon -->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/nen_icon_do"
            android:contentDescription="Xóa tài khoản"
            android:padding="8dp"
            android:src="@drawable/ic_thungrac"
            app:tint="#D64545" />


        <!-- Nội dung -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">


            <!-- Tên chức năng -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/juve_normal"
                android:text="Xóa tài khoản"
                android:textColor="#D64545"
                android:textSize="15sp"
                android:textStyle="bold" />


            <!-- Mô tả -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/juve_normal"
                android:text="Xóa vĩnh viễn dữ liệu cá nhân của bạn"
                android:textColor="#7C8492"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- Điều hướng -->
        <ImageView
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:src="@drawable/ic_arrowright"
            android:tint="#7C8492"
            android:contentDescription="Mũi tên" />

    </LinearLayout>

</LinearLayout>
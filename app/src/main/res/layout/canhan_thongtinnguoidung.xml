<?xml version="1.0" encoding="utf-8"?>

<!--
    Component thông tin người dùng.
    Hiển thị avatar, tên, email, loại tài khoản,
    nâng cấp PRO và chế độ sáng/tối.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_thong_tin_nguoi_dung"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/nen_canhan_card"
    android:orientation="vertical"
    android:padding="16dp"
    android:clickable="true"
    android:focusable="true">


    <!-- Thông tin cơ bản -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">


        <!-- Ảnh đại diện -->
        <ImageView
            android:id="@+id/img_anh_dai_dien"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:contentDescription="Ảnh đại diện"
            android:src="@drawable/nen_anh_dai_dien"
            android:scaleType="centerCrop" />


        <!-- Tên và email -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">


            <!-- Tên + loại tài khoản -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_ho_ten"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lê Trung Kiên"
                    android:textColor="#F4F6FA"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_loai_tai_khoan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="(free)"
                    android:textColor="#8F99AA"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- Email -->
            <TextView
                android:id="@+id/txt_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="ltkien.aug6@gmail.com"
                android:textColor="#9CA6B7"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>


    <!-- Nâng cấp và giao diện -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">


        <!-- Nâng cấp PRO -->
        <LinearLayout
            android:id="@+id/btn_nang_cap_pro"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/nen_canhan_pro"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- Icon PRO -->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="PRO"
                app:srcCompat="@drawable/ic_vip"
                app:tint="#FFFFFF" />

            <!-- Nội dung -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="NÂNG CẤP PRO"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Khoảng trống -->
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />


        <!-- Chế độ giao diện -->
        <LinearLayout
            android:id="@+id/btn_che_do_giao_dien"
            android:layout_width="60dp"
            android:layout_height="30dp"
            android:background="@drawable/nen_canhan_chedo"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Chế độ sáng -->
            <ImageView
                android:id="@+id/img_che_do_sang"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Chế độ sáng"
                app:srcCompat="@drawable/ic_mattroi"
                app:tint="#8F99AA" />

            <!-- Chế độ tối -->
            <ImageView
                android:id="@+id/img_che_do_toi"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="18dp"
                android:contentDescription="Chế độ tối"
                app:srcCompat="@drawable/ic_mattrang"
                app:tint="#FFC93C" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>

<!--
    Màn hình Xếp hạng.

    Gồm 3 tab:
    - Lượt chơi
    - Streak
    - Cộng đồng
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="24dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">


    <!-- ================================================= -->
    <!-- Tiêu đề trang -->
    <!-- ================================================= -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/juve_headin"
        android:text="XẾP HẠNG"
        android:textColor="#111111"
        android:textSize="20sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/juve_normal"
        android:text="Theo dõi thành tích và cộng đồng Kenglish"
        android:textColor="#7C8492"
        android:textSize="13sp" />


    <!-- ================================================= -->
    <!-- Thanh chuyển tab -->
    <!-- ================================================= -->

    <include
        layout="@layout/xephang_tab"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp" />


    <!-- ================================================= -->
    <!-- Bảng xếp hạng -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/khung_bang_xep_hang"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:background="@drawable/nen_xephang_bang"
        android:orientation="vertical">

        <include
            layout="@layout/xephang_tieudebang"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <ListView
            android:id="@+id/list_xep_hang"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#E2E3E3"
            android:dividerHeight="1dp"
            android:scrollbars="none" />

    </LinearLayout>


    <!-- ================================================= -->
    <!-- Cộng đồng -->
    <!-- ================================================= -->

    <FrameLayout
        android:id="@+id/khung_cong_dong"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:visibility="gone">

        <include
            layout="@layout/xephang_congdong"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</LinearLayout>
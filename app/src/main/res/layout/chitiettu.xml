<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="30dp">

        <!-- Thanh điều hướng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_quay_lai"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Quay lại"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                app:tint="#082F70" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textStyle="bold"
                android:text="CHI TIẾT TỪ"
                android:textColor="#082F70"
                android:textSize="17sp" />

        </LinearLayout>

        <!-- Card thông tin từ vựng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/nen_chitiettu_thongtin"
            android:gravity="center_vertical"
            android:minHeight="118dp"
            android:orientation="horizontal"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_tu_vung"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/juve_headin"
                    android:maxLines="2"
                    android:text="abandon"
                    android:textColor="#082F70"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/txt_ipa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/juve_normal"
                    android:text="/əˈbæn.dən/"
                    android:textColor="#8294AD"
                    android:textSize="15sp" />

            </LinearLayout>

            <ImageView
                android:id="@+id/btn_phat_am"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/nen_chitiettu_phatam"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Phát âm"
                android:padding="14dp"
                android:src="@drawable/ic_volume"
                app:tint="#087CFF" />

        </LinearLayout>

        <!-- Đường phân cách -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="#E3EAF4" />

        <!-- Tiêu đề nghĩa -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:textStyle="bold"
            android:text="NGHĨA CỦA TỪ"
            android:textColor="#082F70"
            android:textSize="17sp" />

        <!-- Java thêm các card nghĩa vào đây -->
        <LinearLayout
            android:id="@+id/layout_danh_sach_nghia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <!-- Dữ liệu mẫu, Java có thể xóa khi đổ API -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/nen_chitiettu_nghia"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/nen_chitiettu_loaitu"
                    android:fontFamily="@font/juve_headin"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="Động từ"
                    android:textColor="#087CFF"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/juve_normal"
                    android:lineSpacingExtra="5dp"
                    android:text="1. Bỏ rơi, từ bỏ, ruồng bỏ."
                    android:textColor="#243B55"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/nen_chitiettu_vidu"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Ví dụ"
                        android:src="@drawable/ic_tailieu"
                        app:tint="#087CFF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/juve_normal"
                            android:text="to abandon a hope"
                            android:textColor="#087CFF"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/juve_normal"
                            android:text="từ bỏ một hy vọng"
                            android:textColor="#8294AD"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Nút lưu từ dạng pill -->
        <TextView
            android:id="@+id/btn_luu_tu"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/nen_chitiettu_luutu"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/juve_headin"
            android:gravity="center"
            android:text="+  LƯU VÀO BỘ TỪ"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

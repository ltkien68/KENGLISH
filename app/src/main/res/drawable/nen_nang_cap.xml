<?xml version="1.0" encoding="utf-8"?>

<!--
    Nền gradient Gold cho nút NÂNG CẤP PRO
    Kenglish
-->
<shape
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">


    <!-- Gradient vàng Gold sang cam -->
    <gradient
        android:angle="0"
        android:startColor="#FFD84D"
        android:centerColor="#FFB51B"
        android:endColor="#FF9500"
        android:type="linear" />


    <!-- Bo tròn nút -->
    <corners
        android:radius="30dp" />


</shape>
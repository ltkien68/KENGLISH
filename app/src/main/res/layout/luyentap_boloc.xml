<?xml version="1.0" encoding="utf-8"?>
<GridLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:columnCount="2"
    android:rowCount="2"
    android:useDefaultMargins="false">

    <!-- BỘ TỪ -->
    <LinearLayout
        android:id="@+id/btn_chon_bo_tu"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_columnWeight="1"
        android:layout_margin="5dp"
        android:background="@drawable/nen_luyentap_boloc"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="11dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@drawable/nen_luyentap_diemnhan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif"
                android:text="Bộ từ"
                android:textColor="#8294AD"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_bo_tu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Tất cả bộ từ"
                android:textColor="#0B3475"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/img_mui_ten_bo_tu"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="Mở danh sách bộ từ"
                android:src="@drawable/ic_arrowdown"
                app:tint="#1877F2" />
        </LinearLayout>
    </LinearLayout>

    <!-- TRẠNG THÁI -->
    <LinearLayout
        android:id="@+id/btn_chon_trang_thai"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_columnWeight="1"
        android:layout_margin="5dp"
        android:background="@drawable/nen_luyentap_boloc"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="11dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@drawable/nen_luyentap_diemnhan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif"
                android:text="Trạng thái"
                android:textColor="#8294AD"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_trang_thai"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Tất cả"
                android:textColor="#0B3475"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/img_mui_ten_trang_thai"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="Mở trạng thái"
                android:src="@drawable/ic_arrowdown"
                app:tint="#1877F2" />
        </LinearLayout>
    </LinearLayout>

    <!-- THỨ TỰ -->
    <LinearLayout
        android:id="@+id/btn_chon_thu_tu"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_columnWeight="1"
        android:layout_margin="5dp"
        android:background="@drawable/nen_luyentap_boloc"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="11dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@drawable/nen_luyentap_diemnhan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif"
                android:text="Thứ tự"
                android:textColor="#8294AD"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_thu_tu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Ngẫu nhiên"
                android:textColor="#0B3475"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/img_mui_ten_thu_tu"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="Mở thứ tự"
                android:src="@drawable/ic_arrowdown"
                app:tint="#1877F2" />
        </LinearLayout>
    </LinearLayout>

    <!-- SỐ LƯỢNG -->
    <LinearLayout
        android:id="@+id/btn_chon_so_luong"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_columnWeight="1"
        android:layout_margin="5dp"
        android:background="@drawable/nen_luyentap_boloc"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="11dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@drawable/nen_luyentap_diemnhan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif"
                android:text="Số lượng"
                android:textColor="#8294AD"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_so_luong"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="20 từ"
                android:textColor="#0B3475"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/img_mui_ten_so_luong"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="Mở số lượng"
                android:src="@drawable/ic_arrowdown"
                app:tint="#1877F2" />
        </LinearLayout>
    </LinearLayout>

</GridLayout>

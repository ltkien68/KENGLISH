<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:orientation="vertical">

    <!-- Tiêu đề -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="HÀNH ĐỘNG NHANH"
        android:textColor="#082F70"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Hàng 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Cộng đồng -->
        <LinearLayout
            android:id="@+id/btn_cong_dong"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/nen_trangchu_hanhdong"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/img_cong_dong"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Cộng đồng"
                android:src="@drawable/ic_congdong"
                app:tint="#087CFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="Cộng đồng"
                android:textColor="#082F70"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Đi đến cộng đồng"
                android:src="@drawable/ic_muitenphai"
                app:tint="#37659C" />

        </LinearLayout>

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <!-- Luyện tập -->
        <LinearLayout
            android:id="@+id/btn_luyen_tap_nhanh"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/nen_trangchu_hanhdong"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/img_luyen_tap_nhanh"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Luyện tập"
                android:src="@drawable/ic_trochoi"
                app:tint="#087CFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="Luyện tập"
                android:textColor="#082F70"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Đi đến luyện tập"
                android:src="@drawable/ic_muitenphai"
                app:tint="#37659C" />

        </LinearLayout>

    </LinearLayout>

    <!-- Hàng 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Tạo bộ từ -->
        <LinearLayout
            android:id="@+id/btn_tao_bo_tu_nhanh"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/nen_trangchu_hanhdong"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/img_tao_bo_tu_nhanh"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Tạo bộ từ"
                android:src="@drawable/ic_tailieu"
                app:tint="#087CFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="Tạo bộ từ"
                android:textColor="#082F70"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Đi đến bộ từ"
                android:src="@drawable/ic_muitenphai"
                app:tint="#37659C" />

        </LinearLayout>

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <!-- Trợ lý AI -->
        <LinearLayout
            android:id="@+id/btn_ai_ho_tro"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/nen_trangchu_hanhdong"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/img_ai_ho_tro"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Trợ lý AI"
                android:src="@drawable/ic_trolyao"
                app:tint="#087CFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="Trợ lý AI"
                android:textColor="#082F70"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Mở trợ lý AI"
                android:src="@drawable/ic_muitenphai"
                app:tint="#37659C" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

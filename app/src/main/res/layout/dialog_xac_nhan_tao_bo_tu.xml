<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/nen_dialog_kai"
    android:padding="24dp">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/nen_icon_dialog_kai"
        android:padding="14dp"
        android:src="@drawable/ic_luyentap"
        android:contentDescription="Biểu tượng bộ từ" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/juve_headin"
        android:gravity="center"
        android:text="Tạo bộ từ mới?"
        android:textColor="#0B3475"
        android:textSize="17sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/juve_normal"
        android:gravity="center"
        android:text="Kai đã chuẩn bị thông tin bộ từ theo yêu cầu của bạn."
        android:textColor="#7C8492"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/nen_thong_tin_dialog_kai"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chủ đề"
            android:textColor="#7C8492"
            android:fontFamily="@font/juve_normal"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txt_dialog_chu_de"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/juve_headin"
            android:textColor="#111111"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#EEF4FB" />

        <TextView
            android:id="@+id/txt_dialog_so_luong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/juve_normal"
            android:textColor="#111111"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txt_dialog_hanh_dong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/juve_normal"
            android:textColor="#1877F2"
            android:textSize="13sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_dialog_huy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/nen_nut_huy_dialog_kai"
            android:gravity="center"
            android:fontFamily="@font/juve_headin"
            android:text="Hủy"
            android:textColor="#0B3475"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_dialog_tao"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/nen_nut_tao_dialog_kai"
            android:gravity="center"
            android:fontFamily="@font/juve_headin"
            android:text="Tạo bộ từ"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</LinearLayout>
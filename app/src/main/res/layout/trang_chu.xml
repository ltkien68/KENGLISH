<?xml version="1.0" encoding="utf-8"?>
<!-- Trang chủ Kenglish - Modern Blue Learning -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5FAFF"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/khung_noi_dung_trang_chu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="50dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Thông tin người dùng -->
        <include
            layout="@layout/trangchu_thongtinnguoidung"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Tra từ vựng -->
        <include
            layout="@layout/trangchu_tratu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Banner tạo bộ từ -->
        <include
            layout="@layout/trangchu_taobotu"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="24dp" />

        <!-- Thống kê học tập -->
        <include
            layout="@layout/trangchu_thongke"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />

        <!-- Chuỗi học tập theo tuần -->
        <include
            layout="@layout/trangchu_chuoihoctap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />

        <!-- Hành động nhanh -->
        <include
            layout="@layout/trangchu_hanhdongnhanh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"/>

        <!-- Lịch sử tra từ -->
        <include
            layout="@layout/trangchu_lichsutratu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/nen_popupbotu"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="26dp">

    <!-- Thanh kéo -->
    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/nen_botu_thanhkeo" />

    <!-- Tiêu đề -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:fontFamily="sans-serif-medium"
        android:text="TẠO THƯ MỤC"
        android:textColor="#0B3475"
        android:textSize="19sp"
        android:textStyle="bold" />

    <!-- Tên folder -->
    <EditText
        android:id="@+id/edt_ten_folder"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/nen_onhapbotu"
        android:fontFamily="sans-serif"
        android:hint="Tên thư mục *"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="#0B3475"
        android:textColorHint="#9AA8B8"
        android:textSize="13sp" />

    <!-- Xác nhận -->
    <TextView
        android:id="@+id/btn_xac_nhan_tao_folder"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/nen_nuttaobotu"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="TẠO THƯ MỤC"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

</LinearLayout>

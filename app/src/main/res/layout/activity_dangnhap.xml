<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#182230"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/khung_dang_nhap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="70dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <!-- Logo Kenglish -->
        <ImageView
            android:id="@+id/img_logo"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:contentDescription="Logo Kenglish"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_logo_kenglish" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Chào mừng trở lại!"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Đăng nhập để tiếp tục học cùng Kenglish"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <!-- Email -->
        <EditText
            android:id="@+id/edt_email"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/nen_input_dangnhap"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#8391A5"
            android:textSize="15sp" />

        <!-- Mật khẩu -->
        <EditText
            android:id="@+id/edt_mat_khau"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/nen_input_dangnhap"
            android:hint="Mật khẩu"
            android:inputType="textPassword"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#8391A5"
            android:textSize="15sp" />

        <!-- Submit -->
        <TextView
            android:id="@+id/txt_loi_dang_nhap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tài khoản hoặc mật khẩu không chính xác"
            android:textColor="#FF6B6B"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_dang_nhap"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/nen_nut_xacnhan"
            android:gravity="center"
            android:text="Đăng nhập"
            android:textColor="#182230"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Sang đăng ký -->
        <TextView
            android:id="@+id/txt_dang_ky"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Chưa có tài khoản?  Đăng ký"
            android:textColor="#CBD5E1"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>

<!--
    Component thông tin người dùng.
    Thiết kế trắng - đen - xanh theo giao diện mới Kenglish.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_thong_tin_nguoi_dung"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:orientation="vertical">


    <!-- ================= THÔNG TIN NGƯỜI DÙNG ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">


        <!-- Ảnh đại diện -->
        <ImageView
            android:id="@+id/img_anh_dai_dien"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Ảnh đại diện"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_logo_kenglish" />


        <!-- Tên + email -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">


            <!-- Tên + loại tài khoản -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <!-- Tên -->
                <TextView
                    android:id="@+id/txt_ho_ten"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/juve_headin"
                    android:text="Lê Trung Kiên"
                    android:textColor="#0B3475"
                    android:textStyle="bold"
                    android:textSize="20sp" />


                <!-- Loại tài khoản -->
                <TextView
                    android:id="@+id/txt_loai_tai_khoan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/nen_canhan_free"
                    android:fontFamily="@font/juve_normal"
                    android:paddingStart="7dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="2dp"
                    android:text="Free"
                    android:textColor="#37659C"
                    android:textSize="15sp" />

            </LinearLayout>


            <!-- Email -->
            <TextView
                android:id="@+id/txt_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/juve_normal"
                android:text="ltkien.aug6@gmail.com"
                android:textColor="#7C8492"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>


    <!-- ================= NÂNG CẤP PRO ================= -->

    <LinearLayout
        android:id="@+id/btn_nang_cap_pro"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/nen_canhan_pro"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">


        <!-- Icon PRO -->
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="PRO"
            app:srcCompat="@drawable/ic_vip"
            app:tint="#37659C" />


        <!-- Nội dung -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/juve_headin"
            android:text="NÂNG CẤP PRO"
            android:textColor="#37659C"
            android:textSize="11sp" />


        <!-- Khoảng trống -->
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />


        <!-- Mũi tên -->
        <ImageView
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:contentDescription="Đi tiếp"
            android:src="@drawable/ic_muitenphai"
            app:tint="#37659C" />

    </LinearLayout>

</LinearLayout>
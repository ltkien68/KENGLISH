<?xml version="1.0" encoding="utf-8"?>

<!--
    Component thông báo.
    Chứa chức năng nhắc học.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:orientation="vertical">


    <!-- Tiêu đề -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/juve_headin"
        android:text="THÔNG BÁO"
        android:textColor="#0B3475"
        android:textStyle="bold"
        android:textSize="17sp" />


    <!-- Nhắc học -->
    <LinearLayout
        android:id="@+id/card_nhac_hoc"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">


        <!-- Icon -->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/nen_icon_xanh"
            android:contentDescription="Nhắc học"
            android:padding="8dp"
            android:src="@drawable/ic_thongbao"
            app:tint="#37659C" />


        <!-- Nội dung -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">


            <!-- Tên chức năng -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/juve_normal"
                android:text="Nhắc học"
                android:textColor="#111111"
                android:textSize="15sp"
                android:textStyle="bold" />


            <!-- Mô tả -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/juve_normal"
                android:text="Bật thông báo để duy trì thói quen"
                android:textColor="#7C8492"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- Điều hướng -->
        <ImageView
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:src="@drawable/ic_arrowright"
            android:tint="#7C8492"
            android:contentDescription="Mũi tên" />

    </LinearLayout>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>

<!-- Thanh chuyển giữa 3 chức năng của màn hình Xếp hạng -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/khung_tab_xep_hang"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:background="@drawable/nen_xephang_tab"
    android:padding="5dp">

    <!-- Nền tím của tab đang chọn -->
    <View
        android:id="@+id/thanh_chon_xep_hang"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="@drawable/nen_xephang_tabchon" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Lượt chơi -->
        <TextView
            android:id="@+id/tab_luot_choi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Lượt chơi"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Streak -->
        <TextView
            android:id="@+id/tab_streak"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Streak"
            android:textColor="#AAB4C5"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Cộng đồng -->
        <TextView
            android:id="@+id/tab_cong_dong"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Cộng đồng"
            android:textColor="#AAB4C5"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
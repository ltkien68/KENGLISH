<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="24dp"
    android:paddingEnd="16dp">


    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_quay_lai"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:contentDescription="Quay lại"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_back"
            app:tint="#37659C" />

        <TextView
            android:id="@+id/txt_ten_folder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/juve_headin"
            android:maxLines="1"
            android:text="TOEIC FOLDER"
            android:textColor="#111111"
            android:textSize="20sp" />

    </LinearLayout>


    <!-- MÔ TẢ -->
    <TextView
        android:id="@+id/txt_so_bo_tu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="44dp"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/juve_normal"
        android:text="0 bộ từ"
        android:textColor="#7C8492"
        android:textSize="13sp" />


    <!-- CREATE -->
    <TextView
        android:id="@+id/btn_tao_bo_tu"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/nen_nut_xanh"
        android:fontFamily="@font/juve_headin"
        android:gravity="center"
        android:text="TẠO BỘ TỪ"
        android:textColor="#FFFFFF"
        android:textSize="17sp" />


    <!-- TITLE + SEARCH -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Tiêu đề -->
        <TextView
            android:id="@+id/txt_tieu_de_bo_tu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/juve_headin"
            android:maxLines="1"
            android:text="BỘ TỪ TRONG THƯ MỤC"
            android:textColor="#111111"
            android:textSize="17sp" />


        <!-- Kính lúp -->
        <ImageView
            android:id="@+id/btn_tim_kiem"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:contentDescription="Tìm kiếm bộ từ"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_kinhlup"
            app:tint="#37659C" />


        <!-- Ô tìm kiếm -->
        <LinearLayout
            android:id="@+id/layout_tim_kiem"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/nen_input_botu"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:padding="3dp"
                android:src="@drawable/ic_kinhlup"
                app:tint="#7C8492" />

            <EditText
                android:id="@+id/edt_tim_bo_tu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/juve_normal"
                android:hint="Tìm bộ từ..."
                android:paddingStart="6dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="#4F4F4F"
                android:textColorHint="#A9A9A9"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/btn_dong_tim_kiem"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:clickable="true"
                android:contentDescription="Đóng tìm kiếm"
                android:focusable="true"
                android:padding="7dp"
                android:src="@drawable/ic_close"
                app:tint="#7C8492" />

        </LinearLayout>

    </LinearLayout>


    <!-- DANH SÁCH -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_bo_tu_folder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="16dp"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/layout_folder_trong"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="60dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:padding="10dp"
                android:src="@drawable/ic_folder"
                app:tint="#37659C" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/juve_headin"
                android:text="THƯ MỤC ĐANG TRỐNG"
                android:textColor="#111111"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/juve_normal"
                android:text="Tạo bộ từ mới để bắt đầu học."
                android:textColor="#7C8492"
                android:textSize="15sp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
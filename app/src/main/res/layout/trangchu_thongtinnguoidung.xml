<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal">


    <!-- Avatar người dùng -->
    <TextView
        android:id="@+id/txt_anh_dai_dien"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/nen_anh_dai_dien"
        android:gravity="center"
        android:text="K"
        android:textColor="#182230"
        android:textSize="15sp"
        android:textStyle="bold" />


    <!-- Tên người dùng -->
    <TextView
        android:id="@+id/txt_ten_nguoi_dung"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Kiên"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />


    <!-- Khoảng trống -->
    <Space
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <!-- Chuỗi học -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Số ngày streak -->
        <TextView
            android:id="@+id/txt_chuoi_hoc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="32"
            android:textColor="#FF9F0A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Icon streak -->
        <ImageView
            android:id="@+id/img_chuoi_hoc"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="4dp"
            android:contentDescription="Chuỗi học"
            android:scaleType="centerInside"
            android:src="@drawable/ic_streak"
            app:tint="#FF9F0A" />

    </LinearLayout>


    <!-- Xu -->
    <TextView
        android:id="@+id/txt_xu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:text="39.1k"
        android:textColor="#FFD43B"
        android:textSize="15sp"
        android:textStyle="bold" />


</LinearLayout>

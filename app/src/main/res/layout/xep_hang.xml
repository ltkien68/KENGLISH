<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="50dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- TIÊU ĐỀ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="XẾP HẠNG"
        android:textColor="#0B3475"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif"
        android:text="Theo dõi thành tích và cộng đồng Kenglish"
        android:textColor="#7C8492"
        android:textSize="13sp" />

    <!-- THANH CHUYỂN TAB -->
    <include
        layout="@layout/xephang_tab"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="22dp" />

    <!-- BẢNG XẾP HẠNG -->
    <LinearLayout
        android:id="@+id/khung_bang_xep_hang"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- TIÊU ĐỀ BẢNG -->
        <include
            layout="@layout/xephang_tieudebang"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <!-- DANH SÁCH XẾP HẠNG -->
        <ListView
            android:id="@+id/list_xep_hang"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:cacheColorHint="@android:color/transparent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:overScrollMode="never"
            android:paddingBottom="12dp"
            android:scrollbars="none" />

    </LinearLayout>

    <!-- CỘNG ĐỒNG -->
    <FrameLayout
        android:id="@+id/khung_cong_dong"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_weight="1"
        android:visibility="gone">

        <include
            layout="@layout/xephang_congdong"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</LinearLayout>

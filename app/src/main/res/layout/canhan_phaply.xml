<?xml version="1.0" encoding="utf-8"?>

<!--
    Component pháp lý.
    Chứa chính sách quyền riêng tư và điều khoản sử dụng.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="16dp"
    android:background="@drawable/nen_canhan_card"
    android:orientation="vertical"
    android:padding="16dp">


    <!-- Tiêu đề -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pháp lý"
        android:textColor="#F4F6FA"
        android:textSize="19sp"
        android:textStyle="bold" />


    <!-- Chính sách quyền riêng tư -->
    <LinearLayout
        android:id="@+id/card_chinh_sach_quyen_rieng_tu"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/nen_icon_xanhnhat"
            android:gravity="center"
            android:padding="12dp"
            android:src="@drawable/ic_quyenriengtu"
            app:tint="#4C8FE8" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Chính sách quyền riêng tư"
            android:textColor="#F4F6FA"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#8F99AA"
            android:textSize="32sp" />

    </LinearLayout>


    <!-- Đường phân cách -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="62dp"
        android:background="#344052" />


    <!-- Điều khoản sử dụng -->
    <LinearLayout
        android:id="@+id/card_dieu_khoan_su_dung"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/nen_icon_xanhnhat"
            android:gravity="center"
            android:padding="12dp"
            android:src="@drawable/ic_tailieu"
            app:tint="#4C8FE8" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Điều khoản sử dụng"
            android:textColor="#F4F6FA"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#8F99AA"
            android:textSize="32sp" />

    </LinearLayout>

</LinearLayout>
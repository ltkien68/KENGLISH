<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC"
    android:fillViewport="true"
    android:layout_marginTop="30dp"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <!-- ĐIỀU KHIỂN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_choi_lai_trac_nghiem"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="↻ CHƠI LẠI"
                android:textColor="#087CFF"
                android:textStyle="bold"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btn_tam_dung_trac_nghiem"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="TẠM DỪNG"
                android:textColor="#087CFF"
                android:textStyle="bold"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btn_thoat_trac_nghiem"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="THOÁT"
                android:textStyle="bold"
                android:textColor="#E55454"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- THÔNG TIN CÂU HỎI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_cau_trac_nghiem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Câu 1 / 10"
                android:textColor="#111111"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txt_diem_trac_nghiem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="Đúng: 0"
                android:textColor="#087CFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txt_gio_trac_nghiem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="30s"
                android:textColor="#087CFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- TIẾN ĐỘ CÂU -->
        <ProgressBar
            android:id="@+id/progress_cau_trac_nghiem"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#087CFF"
            android:progressBackgroundTint="#DCE8F7" />

        <!-- THỜI GIAN -->
        <ProgressBar
            android:id="@+id/progress_gio_trac_nghiem"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="5dp"
            android:max="30"
            android:progress="30"
            android:progressTint="#75B4FF"
            android:progressBackgroundTint="#E8EFF8" />

        <!-- CARD CÂU HỎI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/nen_tracnghiem_card"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="16dp"
            android:paddingEnd="12dp"
            android:paddingBottom="14dp">

            <!-- TỪ -->
            <TextView
                android:id="@+id/txt_tu_trac_nghiem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="executive"
                android:textColor="#0B3475"
                android:textStyle=""
                android:textSize="20sp" />

            <!-- PHIÊN ÂM -->
            <TextView
                android:id="@+id/txt_phien_am_trac_nghiem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="/ɪɡˈzekjətɪv/"
                android:textColor="#7C8492"
                android:textSize="13sp" />

            <!-- LOẠI TỪ -->
            <TextView
                android:id="@+id/txt_loai_tu_trac_nghiem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="noun"
                android:textColor="#087CFF"
                android:textSize="11sp" />

            <!-- PHÁT ÂM -->
            <TextView
                android:id="@+id/btn_nghe_trac_nghiem"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/nen_tracnghiem_nghe"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="🔊 Nghe phát âm"
                android:textColor="#087CFF"
                android:textSize="11sp" />

            <!-- 4 ĐÁP ÁN TẠO TỪ JAVA -->
            <LinearLayout
                android:id="@+id/layout_dap_an_trac_nghiem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <!-- PHẢN HỒI -->
            <TextView
                android:id="@+id/txt_phan_hoi_trac_nghiem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="#087CFF"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

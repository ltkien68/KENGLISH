<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/khung_game"
    android:layout_width="match_parent"
    android:layout_height="184dp"
    android:background="@drawable/nen_luyentap_game"
    android:padding="14dp">

    <!-- NỘI DUNG GAME -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ICON -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/nen_luyentap_icon_game">

            <ImageView
                android:id="@+id/img_icon_game"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="Icon game"
                android:scaleType="centerInside"
                android:src="@drawable/ic_flashcard"
                app:tint="#087CFF" />
        </FrameLayout>

        <!-- TÊN GAME -->
        <TextView
            android:id="@+id/txt_ten_game"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Flashcard"
            android:textColor="#111111"
            android:textSize="15sp" />

        <!-- MÔ TẢ -->
        <TextView
            android:id="@+id/txt_mo_ta_game"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="Lật thẻ và ghi nhớ"
            android:textColor="#7C8492"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- PHẦN THƯỞNG -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_gravity="bottom|start"
        android:background="@drawable/nen_luyentap_thuong"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/txt_thuong_game"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="+5"
            android:textColor="#087CFF"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/img_xu_thuong_game"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="5dp"
            android:contentDescription="Xu thưởng"
            android:scaleType="centerInside"
            android:src="@drawable/ic_coin" />
    </LinearLayout>

    <!-- NÚT MỞ GAME -->
    <FrameLayout
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/nen_luyentap_nut_game">

        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="center"
            android:contentDescription="Bắt đầu"
            android:src="@drawable/ic_arrowright"
            app:tint="#FFFFFF" />
    </FrameLayout>
</FrameLayout>

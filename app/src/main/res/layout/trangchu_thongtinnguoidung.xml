<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp">

    <!-- Logo Kenglish -->
    <TextView
        android:id="@+id/txt_anh_dai_dien"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/ic_logo_kenglish"
        android:gravity="center"
        android:text=""
        android:contentDescription="Logo Kenglish"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- Thông tin chào mừng -->
    <LinearLayout
        android:id="@+id/layout_loi_chao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        app:layout_constraintStart_toEndOf="@id/txt_anh_dai_dien"
        app:layout_constraintEnd_toStartOf="@id/khung_chuoi_hoc"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/txt_loi_chao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Xin chào,"
            android:textColor="#7185A3"
            android:textSize="12sp"
            android:fontFamily="sans-serif"/>

        <TextView
            android:id="@+id/txt_ten_nguoi_dung"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Người dùng Kenglish"
            android:textColor="#0B3475"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"/>

        <!-- Lời động viên -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:text="Cùng học thêm hôm nay nhé!"
            android:textColor="#37659C"
            android:textSize="10sp"
            android:fontFamily="sans-serif"/>

    </LinearLayout>

    <!-- Streak dạng badge trắng -->
    <LinearLayout
        android:id="@+id/khung_chuoi_hoc"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:minWidth="58dp"
        android:background="@drawable/nen_trangchu_streak"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/img_chuoi_hoc"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Chuỗi học tập"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_streak"
            app:tint="#1877F2"/>

        <TextView
            android:id="@+id/txt_chuoi_hoc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="0"
            android:textColor="#1877F2"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

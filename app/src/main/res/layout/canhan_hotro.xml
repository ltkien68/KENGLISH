<?xml version="1.0" encoding="utf-8"?>

<!--
    Component hỗ trợ.
    Chứa liên kết cộng đồng và liên hệ hỗ trợ.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:orientation="vertical">


    <!-- Tiêu đề -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/juve_headin"
        android:text="HỖ TRỢ"
        android:textColor="#0B3475"
        android:textStyle="bold"
        android:textSize="17sp" />


    <!-- Cộng đồng Zalo -->
    <LinearLayout
        android:id="@+id/card_cong_dong_zalo"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">


        <!-- Icon -->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/nen_icon_xanh"
            android:contentDescription="Cộng đồng Zalo"
            android:padding="8dp"
            android:src="@drawable/ic_congdong"
            app:tint="#37659C" />


        <!-- Nội dung -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/juve_normal"
                android:text="Cộng đồng Zalo"
                android:textColor="#111111"
                android:textSize="15sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/juve_normal"
                android:text="Vào nhóm chat cùng người học Kenglish"
                android:textColor="#7C8492"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- Điều hướng -->
        <ImageView
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:src="@drawable/ic_arrowright"
            android:tint="#7C8492"
            android:contentDescription="Mũi tên" />

    </LinearLayout>


    <!-- Đường phân cách -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="44dp"
        android:background="#E2E3E3" />


    <!-- Liên hệ hỗ trợ -->
    <LinearLayout
        android:id="@+id/card_lien_he_ho_tro"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">


        <!-- Icon -->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/nen_icon_xanh"
            android:contentDescription="Liên hệ hỗ trợ"
            android:padding="8dp"
            android:src="@drawable/ic_lienhe"
            app:tint="#37659C" />


        <!-- Nội dung -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/juve_normal"
                android:text="Liên hệ hỗ trợ"
                android:textColor="#111111"
                android:textSize="15sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/juve_normal"
                android:text="Nhắn tin cho đội ngũ Kenglish"
                android:textColor="#7C8492"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- Điều hướng -->
        <ImageView
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:src="@drawable/ic_arrowright"
            android:tint="#7C8492"
            android:contentDescription="Mũi tên" />

    </LinearLayout>

</LinearLayout>
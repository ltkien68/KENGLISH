<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Khung tìm kiếm -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/khung_tra_tu"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Tra từ vựng..."
        app:boxBackgroundMode="outline"
        app:boxBackgroundColor="#F5FAFF"
        app:boxCornerRadiusTopStart="22dp"
        app:boxCornerRadiusTopEnd="22dp"
        app:boxCornerRadiusBottomStart="22dp"
        app:boxCornerRadiusBottomEnd="22dp"
        app:boxStrokeColor="@color/mau_vien_input_dang_ky"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:hintEnabled="true"
        app:hintAnimationEnabled="true"
        app:expandedHintEnabled="true"
        app:hintTextColor="@color/mau_vien_input_dang_ky"
        app:startIconDrawable="@drawable/ic_kinhlup"
        app:startIconTint="#1877F2"
        app:startIconContentDescription="Tìm kiếm từ vựng"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edt_tra_tu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@null"
            android:inputType="text"
            android:singleLine="true"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"
            android:textColor="#0B3475"
            android:textColorHint="#7C8492"
            android:textSize="13sp" />

    </com.google.android.material.textfield.TextInputLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

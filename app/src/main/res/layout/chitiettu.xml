<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="22dp">

        <!-- THANH ĐIỀU HƯỚNG -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_quay_lai"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Quay lại"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                app:tint="#0B3475" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:fontFamily="@font/juve_headin"
                android:text="CHI TIẾT TỪ"
                android:textColor="#0B3475"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- CARD THÔNG TIN TỪ VỰNG -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/nen_chitiettu_thongtin"
            android:gravity="center_vertical"
            android:minHeight="96dp"
            android:orientation="horizontal"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_tu_vung"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/juve_headin"
                    android:maxLines="2"
                    android:text="abandon"
                    android:textColor="#0B3475"
                    android:textSize="21sp" />

                <TextView
                    android:id="@+id/txt_ipa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/juve_normal"
                    android:text="/əˈbæn.dən/"
                    android:textColor="#8294AD"
                    android:textSize="12sp" />

            </LinearLayout>

            <ImageView
                android:id="@+id/btn_phat_am"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/nen_chitiettu_phatam"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Phát âm"
                android:padding="11dp"
                android:src="@drawable/ic_volume"
                app:tint="#1877F2" />

        </LinearLayout>

        <!-- ĐƯỜNG PHÂN CÁCH -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="19dp"
            android:background="#E8EEF6" />

        <!-- TIÊU ĐỀ NGHĨA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:fontFamily="@font/juve_headin"
            android:text="NGHĨA CỦA TỪ"
            android:textColor="#0B3475"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- DANH SÁCH NGHĨA -->
        <LinearLayout
            android:id="@+id/layout_danh_sach_nghia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:orientation="vertical">

            <!-- DỮ LIỆU MẪU -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/nen_chitiettu_nghia"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- CHIP LOẠI TỪ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:background="@drawable/nen_chitiettu_loaitu"
                    android:fontFamily="@font/juve_headin"
                    android:gravity="center"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:text="Động từ"
                    android:textColor="#2463A5"
                    android:textSize="11sp" />

                <!-- NGHĨA TIẾNG VIỆT -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:fontFamily="@font/juve_normal"
                    android:lineSpacingExtra="3dp"
                    android:text="1. Bỏ rơi, từ bỏ, ruồng bỏ."
                    android:textColor="#243B55"
                    android:textSize="13sp" />

                <!-- VÍ DỤ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/nen_chitiettu_vidu"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="9dp">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:contentDescription="Ví dụ"
                        android:src="@drawable/ic_tailieu"
                        app:tint="#1877F2" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/juve_normal"
                            android:text="to abandon a hope"
                            android:textColor="#1877F2"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/juve_normal"
                            android:text="từ bỏ một hy vọng"
                            android:textColor="#8294AD"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- NÚT LƯU TỪ -->
        <TextView
            android:id="@+id/btn_luu_tu"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/nen_chitiettu_luutu"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/juve_headin"
            android:gravity="center"
            android:text="+  LƯU VÀO BỘ TỪ"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5FAFF"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/nen_congdong_avatar"
            android:gravity="center"
            android:text="👥"
            android:textSize="19sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Cộng đồng Kenglish"
                android:textColor="#0B3475"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Không gian học tập chung"
                android:textColor="#7C8492"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_lam_moi_cong_dong"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/nen_congdong_nut_lam_moi"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="↻"
            android:textColor="#1877F2"
            android:textSize="21sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="#E5EDF7" />

    <!-- DANH SÁCH TIN NHẮN -->
    <ListView
        android:id="@+id/list_cong_dong"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:listSelector="@android:color/transparent"
        android:overScrollMode="never"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:scrollbars="none" />

    <!-- KHU VỰC NHẬP TIN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/edt_noi_dung_cong_dong"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/nen_congdong_input"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:hint="Nhập tin nhắn..."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#172B4D"
            android:textColorHint="#9AA8BA"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_gui_cong_dong"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/nen_congdong_gui"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="➤"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- GIỚI HẠN TIN NHẮN -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:text="Bạn có thể gửi tối đa 3 tin nhắn mỗi ngày"
        android:textColor="#98A5B5"
        android:textSize="10sp" />

</LinearLayout>

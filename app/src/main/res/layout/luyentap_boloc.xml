<?xml version="1.0" encoding="utf-8"?>

<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:columnCount="2"
    android:rowCount="2"
    android:useDefaultMargins="false">

    <!-- Bộ từ -->
    <LinearLayout
        android:id="@+id/btn_chon_bo_tu"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:background="@drawable/nen_luyentap_boloc"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="13dp"
        android:paddingTop="8dp"
        android:paddingEnd="13dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/juve_normal"
            android:text="Bộ từ"
            android:textColor="#7C8492"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_bo_tu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/juve_headin"
                android:maxLines="1"
                android:text="Tất cả bộ từ"
                android:textColor="#111111"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/img_mui_ten_bo_tu"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Mở danh sách bộ từ"
                android:src="@drawable/ic_arrowdown"
                app:tint="#111111" />
        </LinearLayout>
    </LinearLayout>

    <!-- Trạng thái -->
    <LinearLayout
        android:id="@+id/btn_chon_trang_thai"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:background="@drawable/nen_luyentap_boloc"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="13dp"
        android:paddingTop="8dp"
        android:paddingEnd="13dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/juve_normal"
            android:text="Trạng thái"
            android:textColor="#7C8492"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_trang_thai"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/juve_headin"
                android:text="Đã thuộc"
                android:textColor="#111111"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/img_mui_ten_trang_thai"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Mở trạng thái"
                android:src="@drawable/ic_arrowdown"
                app:tint="#111111" />
        </LinearLayout>
    </LinearLayout>

    <!-- Thứ tự -->
    <LinearLayout
        android:id="@+id/btn_chon_thu_tu"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:background="@drawable/nen_luyentap_boloc"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="13dp"
        android:paddingTop="8dp"
        android:paddingEnd="13dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/juve_normal"
            android:text="Thứ tự"
            android:textColor="#7C8492"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_thu_tu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/juve_headin"
                android:text="Ngẫu nhiên"
                android:textColor="#111111"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/img_mui_ten_thu_tu"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Mở thứ tự"
                android:src="@drawable/ic_arrowdown"
                app:tint="#111111" />
        </LinearLayout>
    </LinearLayout>

    <!-- Số lượng -->
    <LinearLayout
        android:id="@+id/btn_chon_so_luong"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:background="@drawable/nen_luyentap_boloc"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="13dp"
        android:paddingTop="8dp"
        android:paddingEnd="13dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/juve_normal"
            android:text="Số lượng"
            android:textColor="#7C8492"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_so_luong"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/juve_headin"
                android:text="10 từ"
                android:textColor="#111111"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/img_mui_ten_so_luong"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Mở số lượng"
                android:src="@drawable/ic_arrowdown"
                app:tint="#111111" />
        </LinearLayout>
    </LinearLayout>

</GridLayout>

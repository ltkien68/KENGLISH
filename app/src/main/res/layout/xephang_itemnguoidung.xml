<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/card_xep_hang"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="@drawable/nen_xephang_item"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <!-- THỨ HẠNG -->
        <TextView
            android:id="@+id/txt_hang"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/nen_xephang_hang"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="1"
            android:textColor="#526B8C"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <!-- AVATAR -->
        <ImageView
            android:id="@+id/img_anh_dai_dien"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/nen_xephang_avatar"
            android:contentDescription="Ảnh đại diện"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_myplaces"
            android:tint="#1877F2"/>

        <!-- TÊN NGƯỜI DÙNG -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_ten_nguoi_dung"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Tên người dùng"
                android:textColor="#0B3475"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Thành viên Kenglish"
                android:textColor="#8A98AA"
                android:textSize="10sp"/>
        </LinearLayout>

        <!-- ĐIỂM -->
        <LinearLayout
            android:layout_width="70dp"
            android:layout_height="match_parent"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_diem_xep_hang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="0"
                android:textColor="#1877F2"
                android:textSize="12sp"/>

            <ImageView
                android:id="@+id/img_icon_diem"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Loại điểm"
                android:scaleType="centerInside"
                android:src="@drawable/ic_tiaset"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>

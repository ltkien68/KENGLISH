<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/nen_dialog_kai"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chọn mô hình AI"
        android:textColor="#0B3475"
        android:textSize="17sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Chọn mô hình Kai sẽ sử dụng để xử lý yêu cầu."
        android:textColor="#7C8492"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/nhom_model_kai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/radio_model_auto"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:buttonTint="#1877F2"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="Tự động (khuyến nghị)"
            android:textColor="#111111"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/radio_model_flash"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:buttonTint="#1877F2"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="Kai Flash"
            android:textColor="#111111"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/radio_model_lite"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:buttonTint="#1877F2"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="Kai Flash-Lite"
            android:textColor="#111111"
            android:textSize="13sp" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Chế độ Tự động có thể chuyển sang mô hình dự phòng khi dịch vụ quá tải."
        android:textColor="#7C8492"
        android:textSize="11sp" />
</LinearLayout>
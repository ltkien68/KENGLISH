<?xml version="1.0" encoding="utf-8"?>

<!-- Tab Bộ từ -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="24dp"
    android:paddingEnd="16dp">


    <!-- Tiêu đề -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/juve_headin"
        android:text="BỘ TỪ CỦA TÔI"
        android:textColor="#111111"
        android:textSize="20sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/juve_normal"
        android:text="Quản lý và luyện tập các bộ từ của bạn"
        android:textColor="#7C8492"
        android:textSize="15sp" />


    <!-- Các chức năng tạo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <include
            android:id="@+id/component_tao_bo_tu"
            layout="@layout/botu_nuttaobotu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/component_tao_folder"
            layout="@layout/botu_nuttaofolder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1" />

    </LinearLayout>


    <!-- Tiêu đề danh sách -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/juve_headin"
            android:text="BỘ TỪ CỦA BẠN"
            android:textColor="#111111"
            android:textSize="17sp" />

        <ImageView
            android:id="@+id/btn_tim_kiem_bo_tu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:contentDescription="Tìm kiếm bộ từ"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_kinhlup"
            app:tint="#37659C" />

    </LinearLayout>


    <!-- Danh sách bộ từ / folder -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list_bo_tu"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="20dp"
        android:scrollbars="none" />

</LinearLayout>
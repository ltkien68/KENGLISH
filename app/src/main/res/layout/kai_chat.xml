<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5FAFF"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="24dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/txt_avatar_kai"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Avatar trợ lý Kai"
            android:scaleType="centerCrop"
            android:src="@drawable/kai_avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/juve_headin"
                android:text="Kai"
                android:textColor="#0B3475"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/juve_normal"
                android:text="Trợ lý AI của Kenglish"
                android:textColor="#7C8492"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_lam_moi_chat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tạo cuộc trò chuyện mới"
            android:padding="9dp"
            android:src="@android:drawable/ic_menu_add"
            android:tint="#1877F2" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/layout_chao_kai"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:contentDescription="Avatar trợ lý Kai"
                    android:scaleType="centerCrop"
                    android:src="@drawable/kai_avatar" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="@font/juve_headin"
                    android:gravity="center"
                    android:text="Xin chào! Mình là Kai 👋"
                    android:textColor="#111111"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/juve_normal"
                    android:gravity="center"
                    android:text="Người bạn đồng hành cùng bạn trên hành trình chinh phục tiếng Anh."
                    android:textColor="#7C8492"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="36dp"
                    android:fontFamily="@font/juve_headin"
                    android:text="Bạn có thể hỏi mình"
                    android:textColor="#111111"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/goi_y_1"
                    style="@style/KaiSuggestion"
                    android:layout_marginTop="14dp"
                    android:text="Giải thích sự khác nhau giữa do và make  ›" />

                <TextView
                    android:id="@+id/goi_y_2"
                    style="@style/KaiSuggestion"
                    android:text="Tạo 10 từ vựng chủ đề công nghệ  ›" />

                <TextView
                    android:id="@+id/goi_y_3"
                    style="@style/KaiSuggestion"
                    android:text="Cách ghi nhớ từ vựng hiệu quả  ›" />

                <TextView
                    android:id="@+id/goi_y_4"
                    style="@style/KaiSuggestion"
                    android:text="Giải thích thì hiện tại hoàn thành  ›" />
            </LinearLayout>
        </ScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_tin_nhan_kai"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp"
            android:scrollbars="none"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/txt_model_kai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/juve_normal"
            android:text="♌︎ Tự động"
            android:textColor="#37659C"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_chon_model_kai"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/nen_nut_chon_model_kai"
                android:contentDescription="Chọn mô hình AI"
                android:fontFamily="@font/juve_normal"
                android:gravity="center"
                android:text="+"
                android:textColor="#1877F2"
                android:textSize="24sp"
                android:clickable="true"
                android:focusable="true" />

            <EditText
                android:id="@+id/edt_tin_nhan_kai"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/nen_input_kai"
                android:fontFamily="@font/juve_normal"
                android:gravity="center_vertical"
                android:hint="Nhắn tin cho Kai..."
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:minHeight="48dp"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp"
                android:textColor="#111111"
                android:textColorHint="#7C8492"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btn_gui_kai"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/nen_nut_gui_kai"
                android:contentDescription="Gửi tin nhắn"
                android:padding="13dp"
                android:src="@android:drawable/ic_menu_send"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
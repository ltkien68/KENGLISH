<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="24dp"
    android:paddingEnd="16dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_quay_lai"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:contentDescription="Quay lại"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            app:tint="#087CFF" />

        <TextView
            android:id="@+id/txt_ten_folder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="TOEIC FOLDER"
            android:textStyle="bold"
            android:textColor="#0B3475"
            android:textSize="17sp" />

    </LinearLayout>

    <!-- SỐ LƯỢNG BỘ TỪ -->
    <TextView
        android:id="@+id/txt_so_bo_tu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif"
        android:text="0 bộ từ"
        android:textColor="#7C8492"
        android:textSize="13sp" />

    <!-- NÚT TẠO BỘ TỪ -->
    <TextView
        android:id="@+id/btn_tao_bo_tu"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/nen_folder_nuttaobotu"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="+  TẠO BỘ TỪ"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <!-- TIÊU ĐỀ + TÌM KIẾM -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txt_tieu_de_bo_tu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="BỘ TỪ TRONG THƯ MỤC"
            android:textColor="#0B3475"
            android:textStyle="bold"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/btn_tim_kiem"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:contentDescription="Tìm kiếm bộ từ"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_kinhlup"
            app:tint="#087CFF" />

        <!-- INPUT TÌM KIẾM -->
        <LinearLayout
            android:id="@+id/layout_tim_kiem"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/nen_folder_input_timkiem"
            android:descendantFocusability="afterDescendants"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Tìm kiếm"
                android:padding="2dp"
                android:src="@drawable/ic_kinhlup"
                app:tint="#7C8492" />

            <EditText
                android:id="@+id/edt_tim_bo_tu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="sans-serif"
                android:gravity="center_vertical"
                android:hint="Tìm bộ từ..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="0dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="#111111"
                android:textColorHint="#9AA3AF"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/btn_dong_tim_kiem"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:clickable="true"
                android:contentDescription="Đóng tìm kiếm"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/ic_close"
                app:tint="#7C8492" />

        </LinearLayout>

    </LinearLayout>

    <!-- DANH SÁCH BỘ TỪ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_bo_tu_folder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="16dp"
            android:scrollbars="none" />

        <!-- TRẠNG THÁI THƯ MỤC TRỐNG -->
        <LinearLayout
            android:id="@+id/layout_folder_trong"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="60dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="Thư mục trống"
                android:padding="10dp"
                android:src="@drawable/ic_folder"
                app:tint="#087CFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="THƯ MỤC ĐANG TRỐNG"
                android:textColor="#111111"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:text="Tạo bộ từ mới để bắt đầu học."
                android:textColor="#7C8492"
                android:textSize="13sp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>

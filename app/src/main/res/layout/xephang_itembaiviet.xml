<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:orientation="horizontal">

    <!-- AVATAR -->
    <ImageView
        android:id="@+id/img_anh_dai_dien_bai_viet"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/nen_xephang_avatar"
        android:contentDescription="Ảnh đại diện"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@android:drawable/sym_def_app_icon" />

    <!-- CARD BÀI VIẾT -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/nen_xephang_baiviet"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_ten_nguoi_dang"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Người dùng"
                android:textColor="#111111"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txt_thoi_gian_bai_viet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif"
                android:text="12:10"
                android:textColor="#9AA3AF"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_noi_dung_bai_viet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="3dp"
            android:text="Nội dung bài viết"
            android:textColor="#4F4F4F"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
